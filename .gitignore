.vercel/
.netlify/
.wrangler/

# Debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS and editor metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
